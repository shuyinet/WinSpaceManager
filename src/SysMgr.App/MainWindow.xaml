<ui:FluentWindow x:Class="SysMgr.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:SysMgr.App"
        Title="sysmgr — 系统优化管理" Height="800" Width="1320"
        MinHeight="640" MinWidth="1080"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="None"
        Background="{StaticResource WindowBrush}"
        FontFamily="Microsoft YaHei UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Rectangle Fill="{StaticResource AmbientGlow}" Grid.RowSpan="2" />
        <Rectangle Fill="{StaticResource SecondaryGlow}" Grid.RowSpan="2" />

        <!-- ===== 自定义品牌标题栏 ===== -->
        <Grid Grid.Row="0" Height="46">
            <ui:TitleBar x:Name="WinTitleBar" Title="" />
            <StackPanel Orientation="Horizontal" Margin="14,0,0,0"
                        HorizontalAlignment="Left" VerticalAlignment="Center">
                <Grid Width="28" Height="28">
                    <Path Data="M14 1.5 L23.5 5 V12.5 C23.5 18.6 19.4 22.9 14 24.5 C8.6 22.9 4.5 18.6 4.5 12.5 V5 Z"
                          Fill="{StaticResource AccentGradient}" Stroke="#66FFFFFF" StrokeThickness="0.6">
                        <Path.Effect>
                            <DropShadowEffect Color="{StaticResource AccentColor}" BlurRadius="14" ShadowDepth="0" Opacity="0.8" />
                        </Path.Effect>
                    </Path>
                    <TextBlock Text="S" FontSize="14" FontWeight="Bold" Foreground="#041624"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
                <TextBlock Text="sysmgr" FontSize="15" FontWeight="Bold" Margin="10,0,0,0"
                           Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                <Border Background="#2218C0FF" CornerRadius="5" Padding="7,1" Margin="10,0,0,0">
                    <TextBlock Text="V1" FontSize="10.5" Foreground="{StaticResource AccentBrightBrush}" />
                </Border>
            </StackPanel>

            <!-- 自动更新提示 + TRUST-03 自我断网开关 -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Margin="0,0,150,0">
                <!-- 发现新版本：下载中显示进度，下载完成显示「点击更新」 -->
                <Button x:Name="UpdatePill" Margin="0,0,10,0" Cursor="Hand"
                        Visibility="{Binding IsUpdateVisible, Converter={StaticResource BoolToVis}}"
                        ToolTip="发现新版本，点击立即更新"
                        Click="UpdatePill_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="B" CornerRadius="8" Background="#1E18C0FF"
                                    BorderBrush="{StaticResource AccentBrush}" BorderThickness="1"
                                    Padding="12,5">
                                <Border.Effect>
                                    <DropShadowEffect Color="{StaticResource AccentColor}"
                                                      BlurRadius="12" ShadowDepth="0" Opacity="0.45" />
                                </Border.Effect>
                                <ContentPresenter VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="B" Property="Background" Value="#3A18C0FF" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ArrowSync24" Width="14" Height="14"
                                       Margin="0,0,6,0" Foreground="{StaticResource AccentBrightBrush}" />
                        <TextBlock Text="{Binding UpdateText}" FontSize="11.5"
                                   Foreground="{StaticResource AccentBrightBrush}" VerticalAlignment="Center" />
                        <ProgressBar Width="54" Height="4" Margin="8,0,0,0"
                                     Minimum="0" Maximum="1" Value="{Binding UpdateProgress, Mode=OneWay}"
                                     Background="#33FFFFFF" Foreground="{StaticResource AccentBrush}"
                                     BorderThickness="0" VerticalAlignment="Center"
                                     Visibility="{Binding IsUpdateDownloading, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </Button>

                <Border Background="#12000000" CornerRadius="8" Padding="10,4"
                        BorderBrush="{StaticResource StrokeSoftBrush}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ShieldKeyhole20" Width="15" Height="15" Margin="0,0,7,0">
                            <ui:SymbolIcon.Style>
                                <Style TargetType="ui:SymbolIcon">
                                    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDisconnected}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:SymbolIcon.Style>
                        </ui:SymbolIcon>
                        <ui:ToggleSwitch x:Name="DisconnectSwitch"
                                         IsChecked="{Binding IsDisconnected, Mode=OneWay}"
                                         OnContent="已断网" OffContent="自我断网"
                                         MaxWidth="92" FontSize="11.5"
                                         Checked="DisconnectSwitch_Toggled" Unchecked="DisconnectSwitch_Toggled" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- ===== 导航 + 内容 ===== -->
        <ui:NavigationView x:Name="RootNavigation" Grid.Row="1"
                           PaneDisplayMode="Left"
                           IsBackButtonVisible="Collapsed"
                           OpenPaneLength="216"
                           Background="Transparent"
                           Margin="0,4,0,0">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="仪表盘" AutomationProperties.AutomationId="nav-dashboard" Icon="{ui:SymbolIcon Gauge24}" TargetPageType="{x:Type local:Views.DashboardPage}" />
                <ui:NavigationViewItem Content="软件卸载" AutomationProperties.AutomationId="nav-uninstall" Icon="{ui:SymbolIcon AppsList24}" TargetPageType="{x:Type local:Views.UninstallPage}" />
                <ui:NavigationViewItem Content="C盘清理" AutomationProperties.AutomationId="nav-cleanup" Icon="{ui:SymbolIcon Broom24}" TargetPageType="{x:Type local:Views.CleanupPage}" />
                <ui:NavigationViewItem Content="大文件搬家" AutomationProperties.AutomationId="nav-migration" Icon="{ui:SymbolIcon ArrowMove24}" TargetPageType="{x:Type local:Views.MigrationPage}" />
                <ui:NavigationViewItem Content="软件搬家" AutomationProperties.AutomationId="nav-software-move" Icon="{ui:SymbolIcon ArrowExport24}" TargetPageType="{x:Type local:Views.SoftwareMovePage}" />
                <ui:NavigationViewItem Content="截图工具" AutomationProperties.AutomationId="nav-screenshot" Icon="{ui:SymbolIcon Screenshot24}" TargetPageType="{x:Type local:Views.ScreenshotPage}" />
                <ui:NavigationViewItem Content="磁盘分析" AutomationProperties.AutomationId="nav-visualization" Icon="{ui:SymbolIcon DataUsage24}" TargetPageType="{x:Type local:Views.VisualizationPage}" />
                <ui:NavigationViewItem Content="启动项管理" AutomationProperties.AutomationId="nav-startup" Icon="{ui:SymbolIcon Rocket24}" TargetPageType="{x:Type local:Views.StartupPage}" />
                <ui:NavigationViewItem Content="文件粉碎" AutomationProperties.AutomationId="nav-shred" Icon="{ui:SymbolIcon DocumentDismiss24}" TargetPageType="{x:Type local:Views.ShredPage}" />
            </ui:NavigationView.MenuItems>
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem Content="操作直播" AutomationProperties.AutomationId="nav-live" Icon="{ui:SymbolIcon Live24}" TargetPageType="{x:Type local:Views.LiveStreamPage}" />
                <ui:NavigationViewItem Content="设置" AutomationProperties.AutomationId="nav-settings" Icon="{ui:SymbolIcon Settings24}" TargetPageType="{x:Type local:Views.SettingsPage}" />
            </ui:NavigationView.FooterMenuItems>
        </ui:NavigationView>
    </Grid>
</ui:FluentWindow>
