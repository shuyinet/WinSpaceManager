<Page x:Class="SysMgr.App.Views.CleanupPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="C盘清理">
    <Page.Resources>
        <!-- 垃圾卡片：整卡可勾选；选中描边高亮 + 角标勾选，未选保持可读（不整体变暗） -->
        <Style x:Key="JunkTile" TargetType="CheckBox">
            <Setter Property="Width" Value="192" />
            <Setter Property="Height" Value="100" />
            <Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="ToolTipService.ShowDuration" Value="20000" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Border x:Name="B" CornerRadius="12" Padding="13,12"
                                    Background="#0EFFFFFF" BorderBrush="#1CFFFFFF" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="42" Height="42" CornerRadius="11" VerticalAlignment="Top"
                                            Background="{Binding AccentSoftBrush}">
                                        <Grid>
                                            <ui:SymbolIcon Symbol="{Binding Icon}" Width="21" Height="21"
                                                           Foreground="{Binding AccentBrush}"
                                                           Visibility="{Binding IsNotCleaning, Converter={StaticResource BoolToVis}}" />
                                            <ui:ProgressRing Width="20" Height="20" IsIndeterminate="True"
                                                             Foreground="{Binding AccentBrush}"
                                                             Visibility="{Binding IsCleaning, Converter={StaticResource BoolToVis}}" />
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="11,1,0,0">
                                        <TextBlock x:Name="NameText" Text="{Binding Name}" FontSize="13"
                                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="{Binding MetaText}" FontSize="11" Margin="0,3,0,0"
                                                   Foreground="{StaticResource TextMutedBrush}" />
                                        <Border CornerRadius="6" Padding="6,1" Margin="0,7,0,0"
                                                HorizontalAlignment="Left"
                                                Background="{Binding AccentSoftBrush}">
                                            <TextBlock Text="{Binding SizeText}" FontSize="11.5" FontWeight="SemiBold"
                                                       Foreground="{Binding AccentBrush}" />
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border x:Name="Mark" Width="18" Height="18" CornerRadius="9"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0"
                                    Background="{StaticResource AccentGradient}" Visibility="Collapsed">
                                <ui:SymbolIcon Symbol="Checkmark24" Width="11" Height="11" Foreground="#031522" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#1AFFFFFF" />
                                <Setter TargetName="B" Property="BorderBrush" Value="#40FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{Binding AccentSoftBrush}" />
                                <Setter TargetName="B" Property="BorderBrush" Value="{Binding AccentBrush}" />
                                <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Mark" Property="Background" Value="{Binding AccentBrush}" />
                                <Setter TargetName="NameText" Property="Foreground" Value="#EAF8FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled" Background="Transparent"
                  AutomationProperties.AutomationId="cleanup-scroll"
                  PreviewMouseWheel="PageScroll_PreviewMouseWheel">
        <StackPanel Margin="26,18,26,24">

            <!-- ===== 页头 ===== -->
            <StackPanel Margin="2,0,0,16">
                <TextBlock Text="C盘清理" FontSize="24" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Text="扫描 C 盘的系统垃圾、应用缓存与浏览器数据，按分类汇总并可分组勾选；所有操作经 TRUST-02 预演确认"
                           FontSize="12.5" Margin="2,5,0,0" Foreground="{StaticResource TextMutedBrush}" />
            </StackPanel>

            <!-- ===== 汇总横幅 ===== -->
            <Border Style="{StaticResource TechCard}" Padding="20,16" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Width="52" Height="52" CornerRadius="13" Margin="0,0,16,0"
                            Background="#1A18C0FF" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Broom24" Width="27" Height="27"
                                       Foreground="{StaticResource AccentBrightBrush}" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="可释放" FontSize="13" Margin="0,0,8,0"
                                       Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Bottom" />
                            <TextBlock Text="{Binding TotalText}" FontSize="24" FontWeight="Bold"
                                       Foreground="{StaticResource AccentBrightBrush}" VerticalAlignment="Bottom" />
                            <TextBlock Text="已选" FontSize="13" Margin="18,0,8,0"
                                       Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Bottom" />
                            <TextBlock Text="{Binding SelectedText}" FontSize="17" FontWeight="SemiBold"
                                       Foreground="{StaticResource WarningBrush}" VerticalAlignment="Bottom" />
                            <TextBlock Text="{Binding SelectedCount, StringFormat=' · {0} 项'}" FontSize="12"
                                       Margin="6,0,0,0" Foreground="{StaticResource TextMutedBrush}"
                                       VerticalAlignment="Bottom" />
                        </StackPanel>
                        <TextBlock Text="{Binding StatusText}" FontSize="12" Margin="0,7,0,0"
                                   Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:ProgressRing Width="24" Height="24" Margin="0,0,12,0" VerticalAlignment="Center"
                                         IsIndeterminate="{Binding IsBusy}"
                                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                        <Button Style="{StaticResource GhostButton}" Content="取消清理" Height="36"
                                Command="{Binding CancelCommand}" Margin="0,0,8,0"
                                Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}" />
                        <Button Style="{StaticResource GhostButton}" Content="{Binding ScanButtonText}" Height="36"
                                Command="{Binding ScanCommand}" Margin="0,0,8,0"
                                AutomationProperties.AutomationId="cleanup-scan" />
                        <Button Style="{StaticResource GlowButton}" Content="{Binding CleanButtonText}" Height="40"
                                Padding="20,0" Command="{Binding CleanCommand}"
                                AutomationProperties.AutomationId="cleanup-clean" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== 扫描范围 ===== -->
            <Border Style="{StaticResource TechCard}" Padding="18,12" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="扫描范围" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                               Margin="0,0,18,0" Foreground="{StaticResource TextPrimaryBrush}" />
                    <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                        <CheckBox Content="系统垃圾" IsChecked="{Binding ScanSystemJunk}" Margin="0,0,20,0" />
                        <CheckBox Content="浏览器缓存" IsChecked="{Binding ScanBrowserCache}" Margin="0,0,20,0" />
                        <CheckBox Content="浏览器历史" IsChecked="{Binding ScanBrowserHistory}" Margin="0,0,20,0" />
                        <CheckBox Content="浏览器 Cookies" IsChecked="{Binding ScanBrowserCookies}" Margin="0,0,20,0" />
                        <CheckBox Content="清理前结束浏览器进程" IsChecked="{Binding KillRunningBrowsers}" />
                    </WrapPanel>
                </Grid>
            </Border>

            <!-- ===== 分类结果 ===== -->
            <Grid Margin="2,4,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="清理分类" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"
                           Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Grid.Column="1" Text="按分类汇总；取消勾选可保留该项" FontSize="12" Margin="10,2,0,0"
                           VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" />
                <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="一键清理（默认项）"
                        Height="30" FontSize="12" Padding="12,0"
                        Command="{Binding OneClickCleanCommand}" />
            </Grid>

            <!-- 空态 -->
            <Border Style="{StaticResource TechCard}" Padding="26" Margin="0,0,0,12"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                <StackPanel HorizontalAlignment="Center">
                    <ui:SymbolIcon Symbol="Broom24" Width="32" Height="32"
                                   Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding EmptyHintText}" Margin="0,10,0,0" FontSize="13"
                               HorizontalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" />
                </StackPanel>
            </Border>

            <!-- 分组卡片 -->
            <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource TechCard}" Padding="16,14" Margin="0,0,0,12">
                            <StackPanel>
                                <!-- 组头：图标 + 名称 + N 项 + 全选 + 小计 + 折叠 -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Width="30" Height="30" CornerRadius="8" VerticalAlignment="Center"
                                            Background="{Binding AccentSoftBrush}">
                                        <ui:SymbolIcon Symbol="{Binding Icon}" Width="16" Height="16"
                                                       Foreground="{Binding AccentBrush}" />
                                    </Border>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontSize="14.5" FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                        <Border Background="#14FFFFFF" CornerRadius="5" Padding="6,1" Margin="8,0,0,0"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ItemCountText}" FontSize="10.5"
                                                       Foreground="{StaticResource TextMutedBrush}" />
                                        </Border>
                                    </StackPanel>

                                    <CheckBox Grid.Column="3" Content="全选" FontSize="12" VerticalAlignment="Center"
                                              Margin="0,0,16,0" IsChecked="{Binding IsAllSelected, Mode=TwoWay}" />

                                    <TextBlock Grid.Column="4" Text="{Binding SummaryText}" FontSize="12"
                                               VerticalAlignment="Center" Margin="0,0,6,0"
                                               Foreground="{StaticResource TextMutedBrush}" />

                                    <ToggleButton Grid.Column="5" Width="28" Height="28" Cursor="Hand"
                                                  IsChecked="{Binding IsExpanded, Mode=TwoWay}">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border x:Name="B" CornerRadius="7" Background="Transparent">
                                                    <ui:SymbolIcon x:Name="Chev" Symbol="ChevronUp24" Width="13" Height="13"
                                                                   Foreground="{StaticResource TextMutedBrush}" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="False">
                                                        <Setter TargetName="Chev" Property="Symbol" Value="ChevronDown24" />
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="B" Property="Background" Value="#14FFFFFF" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                </Grid>

                                <Border Height="1" Background="#14FFFFFF" Margin="0,12,0,0" />

                                <ItemsControl ItemsSource="{Binding Tiles}" Margin="0,12,0,0"
                                              Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Style="{StaticResource JunkTile}"
                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      IsEnabled="{Binding IsNotCleaning}"
                                                      ToolTip="{Binding TooltipText}"
                                                      AutomationProperties.Name="{Binding Name}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Margin="2,4,0,0" FontSize="12" TextWrapping="Wrap"
                       Foreground="{StaticResource TextMutedBrush}"
                       Text="提示：系统垃圾默认勾选；浏览器隐私数据中仅缓存默认勾选。一键清理与立即清理均经 TRUST-02 预演确认。" />
        </StackPanel>
    </ScrollViewer>
</Page>
