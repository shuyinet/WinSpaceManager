<Window x:Class="SysMgr.App.Views.PreviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Width="900"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Border CornerRadius="16"
            Background="{StaticResource WindowBrush}"
            BorderBrush="{StaticResource StrokeBrush}"
            BorderThickness="1"
            Margin="12">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="30" ShadowDepth="0" Opacity="0.6" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ===== 自定义标题栏 ===== -->
            <Grid x:Name="TitleBar" Height="50" Background="Transparent"
                  MouseLeftButtonDown="TitleBar_MouseDown">
                <StackPanel Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                    <Border Width="26" Height="26" CornerRadius="7"
                            Background="{StaticResource AccentGradient}" Margin="0,0,10,0">
                        <ui:SymbolIcon Symbol="ShieldKeyhole20" Width="15" Height="15"
                                       Foreground="#031522" />
                    </Border>
                    <TextBlock Text="操作预演" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    <Border Style="{StaticResource Badge}" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="TRUST-02" FontSize="10.5"
                                   Foreground="{StaticResource AccentBrightBrush}" />
                    </Border>
                </StackPanel>
                <Button x:Name="CloseBtn" Width="34" Height="34" HorizontalAlignment="Right"
                        Margin="0,0,10,0" Click="Close_Click" Cursor="Hand"
                        Background="Transparent" BorderThickness="0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="B" CornerRadius="8" Background="Transparent">
                                <ui:SymbolIcon Symbol="Dismiss20" Width="14" Height="14"
                                               Foreground="{StaticResource TextSecondaryBrush}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="B" Property="Background" Value="#22FF4D62" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- ===== 内容 ===== -->
            <StackPanel Grid.Row="1" Margin="20,2,20,20">

                <!-- 描述 + 徽标组 -->
                <TextBlock x:Name="DescriptionText" TextWrapping="Wrap"
                           FontSize="18" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}" />
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Border Style="{StaticResource Badge}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="模块 " FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" />
                            <TextBlock x:Name="ModuleText" FontSize="11.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Badge}" Margin="0,0,8,0">
                        <TextBlock x:Name="FrText" FontSize="11.5"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                    </Border>
                    <Border x:Name="SafetyBadge" CornerRadius="6" Padding="8,2" Margin="0,0,8,0">
                        <TextBlock x:Name="SafetyText" FontSize="11.5" FontWeight="SemiBold" />
                    </Border>
                </StackPanel>

                <!-- 动作清单 -->
                <Border Style="{StaticResource TechCard}" Margin="0,16,0,0" Padding="6">
                    <DataGrid x:Name="ActionGrid"
                              Style="{StaticResource Dark.DataGrid}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              MaxHeight="300">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="40" />
                            <DataGridTemplateColumn Header="动作" Width="118">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="7" Height="7" Margin="0,0,8,0"
                                                     Fill="{Binding KindColor}" />
                                            <TextBlock Text="{Binding KindText}"
                                                       Foreground="{Binding KindColor}"
                                                       FontSize="12.5" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="目标" Binding="{Binding Subject}" Width="2.4*" />
                            <DataGridTextColumn Header="影响 / 变更" Binding="{Binding Impact}" Width="1.7*" />
                            <DataGridTextColumn Header="大小" Binding="{Binding SizeText}" Width="90" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- 提示条：普通 -->
                <Border x:Name="InfoBar" CornerRadius="9" Background="#1218C0FF" Padding="12,9"
                        Margin="0,12,0,0">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Info24" Width="15" Height="15" Margin="0,0,8,0"
                                       Foreground="{StaticResource AccentBrightBrush}" />
                        <TextBlock Text="确认后将先生成回滚快照再执行；如执行失败会自动回滚。"
                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- 提示条：Low 高风险 -->
                <Border x:Name="DangerBar" CornerRadius="9" Background="#1FFF4D62" Padding="12,10"
                        Margin="0,12,0,0" Visibility="Collapsed">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Warning24" Width="15" Height="15" Margin="0,0,8,0"
                                           Foreground="{StaticResource DangerBrush}" />
                            <TextBlock Text="该操作安全等级为 Low，可能影响系统或软件稳定性，请仔细核对上方每一项。"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource DangerBrush}" />
                        </StackPanel>
                        <CheckBox x:Name="AckBox" Margin="0,8,0,0"
                                  Foreground="{StaticResource TextSecondaryBrush}"
                                  Content="我已知晓风险并确认执行"
                                  Checked="Ack_Changed" Unchecked="Ack_Changed" />
                    </StackPanel>
                </Border>

                <!-- 备注 -->
                <TextBox x:Name="NoteBox" Margin="0,12,0,0" Height="34"
                         VerticalContentAlignment="Center" Padding="10,0"
                         Background="{StaticResource CardAltBrush}"
                         BorderBrush="{StaticResource StrokeSoftBrush}"
                         BorderThickness="1"
                         Foreground="{StaticResource TextPrimaryBrush}"
                         CaretBrush="{StaticResource AccentBrush}"
                         Text="备注（可选，仅记录到操作历史）" />

                <!-- 底部按钮 -->
                <Grid Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource GhostButton}"
                            Content="导出清单" Click="Export_Click" />
                    <Button Grid.Column="2" Style="{StaticResource GhostButton}"
                            Content="取消" Margin="0,0,10,0" Click="Cancel_Click" Width="96" />
                    <Button Grid.Column="3" x:Name="ConfirmButton" Style="{StaticResource GlowButton}"
                            Content="确认执行" Click="Confirm_Click" Width="132" />
                </Grid>

            </StackPanel>
        </Grid>
    </Border>
</Window>
