<Window x:Class="SysMgr.App.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Width="560"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Border CornerRadius="16"
            Background="{StaticResource WindowBrush}"
            BorderBrush="{StaticResource StrokeBrush}"
            BorderThickness="1"
            Margin="12">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="30" ShadowDepth="0" Opacity="0.6" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Grid x:Name="TitleBar" Height="50" Background="Transparent"
                  MouseLeftButtonDown="TitleBar_MouseDown">
                <StackPanel Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                    <Border Width="26" Height="26" CornerRadius="7"
                            Background="#22FFB23E" Margin="0,0,10,0">
                        <ui:SymbolIcon Symbol="Warning20" Width="15" Height="15"
                                       Foreground="#FFD08A" />
                    </Border>
                    <TextBlock x:Name="TitleText" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <Button Width="34" Height="34" HorizontalAlignment="Right"
                        Margin="0,0,10,0" Click="Secondary_Click" Cursor="Hand"
                        Background="Transparent" BorderThickness="0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="B" CornerRadius="8" Background="Transparent">
                                <ui:SymbolIcon Symbol="Dismiss20" Width="14" Height="14"
                                               Foreground="{StaticResource TextSecondaryBrush}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="B" Property="Background" Value="#22FF4D62" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- 正文 -->
            <TextBlock x:Name="MessageText" Grid.Row="1" Margin="24,2,24,0"
                       FontSize="13" LineHeight="22" TextWrapping="Wrap"
                       Foreground="{StaticResource TextSecondaryBrush}" />

            <!-- 按钮 -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                        Margin="24,20,24,22">
                <Button x:Name="SecondaryBtn" Style="{StaticResource GhostButton}"
                        MinWidth="88" Click="Secondary_Click" />
                <Button x:Name="PrimaryBtn" Style="{StaticResource DangerButton}"
                        MinWidth="112" Margin="10,0,0,0" Click="Primary_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
