<Page x:Class="SysMgr.App.Views.ShredPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="文件粉碎"
      AllowDrop="True"
      DragOver="Page_DragOver" Drop="Page_Drop">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="Transparent">
        <StackPanel Margin="26,18,26,24">

            <!-- ===== 页头 ===== -->
            <Grid Margin="2,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="文件粉碎" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="多遍覆写后强制删除，粉碎后不可恢复、不进入回滚历史；系统关键路径一律拒绝"
                               Style="{StaticResource PageSubtitle}" />
                </StackPanel>
                <Border Grid.Column="1" Style="{StaticResource Badge}" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusText}" FontSize="12"
                               Foreground="{StaticResource AccentBrightBrush}" />
                </Border>
            </Grid>

            <!-- ===== 高危警示条 ===== -->
            <Border Background="#26FF4D62" BorderBrush="#66FF4D62" BorderThickness="1"
                    CornerRadius="8" Padding="12,8" Margin="0,0,0,14">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Warning24" Width="16" Height="16"
                                   Foreground="#FF4D62" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock FontSize="12" Foreground="#FF8A96" TextWrapping="Wrap"
                               Text="高危操作：粉碎经多遍覆写销毁数据，任何工具都无法恢复。请确认列表中没有仍需使用的文件。" />
                </StackPanel>
            </Border>

            <!-- ===== 操作区 ===== -->
            <Border Style="{StaticResource TechCard}" Margin="0,0,0,14" Padding="16,12">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource GlowButton}" Content="添加文件"
                                Click="AddFiles_Click" Margin="0,0,8,0" />
                        <Button Style="{StaticResource GhostButton}" Content="添加文件夹"
                                Click="AddFolder_Click" Margin="0,0,8,0" />
                        <Button Style="{StaticResource GhostButton}" Content="移除选中"
                                Command="{Binding RemoveCommand}" Margin="0,0,8,0" />
                        <Button Style="{StaticResource GhostButton}" Content="清空列表"
                                Command="{Binding ClearCommand}" Margin="0,0,14,0" />
                        <ui:ProgressRing Width="28" Height="28" Margin="6,0,0,0" VerticalAlignment="Center"
                                         IsIndeterminate="{Binding IsBusy}"
                                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0" VerticalAlignment="Center">
                        <TextBlock Text="粉碎档位：" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,0,8,0" />
                        <RadioButton Content="快速 · 1 遍零写" GroupName="ShredMode" FontSize="12"
                                     IsChecked="{Binding ModeQuick}" Margin="0,0,12,0" />
                        <RadioButton Content="安全 · 3 遍覆写" GroupName="ShredMode" FontSize="12"
                                     IsChecked="{Binding ModeSecure3}" Margin="0,0,12,0" />
                        <RadioButton Content="安全 · 7 遍覆写（DoD）" GroupName="ShredMode" FontSize="12"
                                     IsChecked="{Binding ModeSecure7}" Margin="0,0,20,0" />
                        <Button Style="{StaticResource DangerButton}" Content="开始粉碎"
                                Command="{Binding ShredCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ===== 目标列表 ===== -->
            <DataGrid Style="{StaticResource Dark.DataGrid}"
                      ItemsSource="{Binding Targets}"
                      SelectedItem="{Binding SelectedItem}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      SelectionMode="Single"
                      MinHeight="240">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="类型" Binding="{Binding KindText, Mode=OneWay}" Width="0.5*" />
                    <DataGridTextColumn Header="路径" Binding="{Binding Target.Path, Mode=OneWay}" Width="3.2*" />
                    <DataGridTextColumn Header="文件数" Binding="{Binding CountText, Mode=OneWay}" Width="0.7*" />
                    <DataGridTextColumn Header="大小" Binding="{Binding SizeText, Mode=OneWay}" Width="0.7*" />
                </DataGrid.Columns>
            </DataGrid>

            <!-- ===== 提示 ===== -->
            <TextBlock Margin="2,14,0,0" FontSize="12" TextWrapping="Wrap"
                       Foreground="{StaticResource TextMutedBrush}"
                       Text="提示：可直接把文件/文件夹拖入本页；文件夹将递归统计全部文件（含只读/隐藏）。点「开始粉碎」后仍需在预演面板确认动作清单；链接/挂载点与系统关键路径会被拒绝。" />
        </StackPanel>
    </ScrollViewer>
</Page>
