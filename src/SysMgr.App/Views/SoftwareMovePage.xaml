<Page x:Class="SysMgr.App.Views.SoftwareMovePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="软件搬家" Loaded="Page_Loaded">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- 列表内联勾选框：自带模板，避免与 DataGrid 单元格样式叠加导致显示异常 -->
        <Style x:Key="RowCheckBox" TargetType="CheckBox">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="18" Height="18" Background="Transparent">
                            <Border x:Name="Box" CornerRadius="5" Background="#14FFFFFF"
                                    BorderBrush="#59FFFFFF" BorderThickness="1.2" />
                            <Path x:Name="Tick" Data="M 4,9 L 7.5,12.5 L 14,5" Stroke="#031522"
                                  StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="Transparent">
        <StackPanel Margin="26,18,26,24">

            <!-- ===== 页头 ===== -->
            <Grid Margin="2,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Border Width="46" Height="46" CornerRadius="12" Background="#1A18C0FF" Margin="0,0,12,0">
                        <ui:SymbolIcon Symbol="ArrowExport24" FontSize="22"
                                       Foreground="{StaticResource AccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource PageTitle}" Text="{Binding HeaderText}" />
                        <TextBlock Style="{StaticResource PageSubtitle}"
                                   Text="把已装软件整体搬到其他盘，原目录保留联接，软件仍按原路径启动" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource GhostButton}" Content="重新扫描"
                            Command="{Binding ScanCommand}" Margin="0,0,10,0" />
                    <Button Style="{StaticResource GlowButton}" Content="开始搬家"
                            Command="{Binding MoveCommand}" />
                </StackPanel>
            </Grid>

            <!-- ===== 选择统计 ===== -->
            <Border Style="{StaticResource TechCardAlt}" Padding="16,10" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock VerticalAlignment="Center">
                        <Run Text="已选择 " Foreground="{StaticResource TextSecondaryBrush}" />
                        <Run Text="{Binding SelectedCount, Mode=OneWay}" FontWeight="SemiBold"
                             Foreground="{StaticResource AccentBrush}" />
                        <Run Text=" 款，可释放空间：" Foreground="{StaticResource TextSecondaryBrush}" />
                        <Run Text="{Binding SelectedText, Mode=OneWay}" FontWeight="SemiBold"
                             Foreground="{StaticResource AccentBrush}" />
                    </TextBlock>

                    <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="12"
                               Foreground="{StaticResource TextMutedBrush}" MaxWidth="460"
                               TextTrimming="CharacterEllipsis" Text="{Binding StatusText}" />
                </Grid>
            </Border>

            <!-- ===== 软件列表 ===== -->
            <Border Style="{StaticResource TechCard}" Padding="12" Margin="0,0,0,12">
                <StackPanel>

                    <!-- 搜索框 -->
                    <Border Background="#10000000" CornerRadius="8" Height="34" Margin="0,0,0,10"
                            BorderBrush="{StaticResource StrokeSoftBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Symbol="Search24" Width="16" Height="16" Margin="10,0,0,0"
                                           Foreground="{StaticResource TextMutedBrush}" />
                            <TextBox Grid.Column="1" Margin="6,0,10,0"
                                     AutomationProperties.AutomationId="txt-software-move-filter"
                                     VerticalContentAlignment="Center"
                                     BorderThickness="0" Background="Transparent"
                                     Foreground="{StaticResource TextPrimaryBrush}"
                                     Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                    </Border>

                    <!-- 空状态 -->
                    <Border Padding="40,28" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                        <StackPanel HorizontalAlignment="Center">
                            <Border Width="60" Height="60" CornerRadius="16"
                                    Background="#1018C0FF" HorizontalAlignment="Center">
                                <ui:SymbolIcon Symbol="ArrowExport24" Width="26" Height="26"
                                               Foreground="{StaticResource AccentBrush}" />
                            </Border>
                            <TextBlock Text="尚未扫描到可搬家的软件" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,14,0,4"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="只列出装在 C 盘且登记了安装目录的软件；点击右上角「重新扫描」开始"
                                       FontSize="12.5" Foreground="{StaticResource TextMutedBrush}"
                                       HorizontalAlignment="Center" TextAlignment="Center"
                                       MaxWidth="460" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <DataGrid Style="{StaticResource Dark.DataGrid}"
                              AutomationProperties.AutomationId="grid-software-move"
                              ItemsSource="{Binding ItemsView}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserSortColumns="True"
                              MinHeight="180"
                              MaxHeight="430"
                              Visibility="{Binding HasItems, Converter={StaticResource BoolToVis}}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="46" CanUserSort="False" CanUserResize="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox Style="{StaticResource RowCheckBox}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="软件名称" Width="2.2*" SortMemberPath="Name">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid VerticalAlignment="Center" Margin="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="32" Height="32" CornerRadius="8"
                                                    Margin="0,0,10,0" Background="#10FFFFFF">
                                                <Image Width="22" Height="22"
                                                       Source="{Binding IconPath, Converter={StaticResource IconToImage}}" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="13"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                                <TextBlock Text="{Binding Subtitle}" FontSize="11"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{StaticResource TextMutedBrush}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="安装目录" Binding="{Binding InstallPath}" Width="2.4*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontSize" Value="12" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                        <Setter Property="ToolTip" Value="{Binding InstallPath}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="大小" Binding="{Binding SizeText}" Width="0.9*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontSize" Value="12.5" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTemplateColumn Header="操作" Width="96" CanUserSort="False" CanUserResize="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource GhostButton}" Content="搬家"
                                                Height="26" MinWidth="62" Padding="10,0" FontSize="12"
                                                VerticalAlignment="Center"
                                                Command="{Binding DataContext.MoveSingleCommand, RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- ===== 底部：目标位置 + 记录 ===== -->
            <Border Style="{StaticResource TechCardAlt}" Padding="16,10" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="FolderOpen24" FontSize="16" Margin="0,0,8,0"
                                       Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock Text="搬家到：" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding DestinationPath}" VerticalAlignment="Center"
                                   FontWeight="SemiBold" MaxWidth="520" TextTrimming="CharacterEllipsis"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Style="{StaticResource GhostButton}" Content="选择其他位置" Height="30"
                                Padding="12,0" Margin="0,0,8,0" Click="ChooseDestination_Click" />
                        <Button Style="{StaticResource GhostButton}" Content="搬家记录" Height="30"
                                Padding="12,0" Command="{Binding ToggleRecordsCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== 搬家记录 ===== -->
            <Border Style="{StaticResource TechCard}" Margin="0,0,0,12"
                    Visibility="{Binding ShowRecords, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="搬家记录" Style="{StaticResource SectionTitle}" Margin="0,0,0,10" />

                    <ItemsControl ItemsSource="{Binding Records}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="76" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="{Binding TimeText}" FontSize="12"
                                               Foreground="{StaticResource TextMutedBrush}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Summary}" FontSize="12.5"
                                               Margin="0,0,16,0"
                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Grid.Column="2" Text="{Binding Destination}" FontSize="12"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource TextMutedBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ===== 流程提示 ===== -->
            <TextBlock Margin="2,2,0,0" Opacity="0.7" TextWrapping="Wrap"
                       Foreground="{StaticResource TextMutedBrush}"
                       Text="搬家流程：复制到目标盘 → SHA-256 校验 → 校验通过后删除源目录 → 在原位置创建目录联接（Junction）。联接后原路径仍可访问，快捷方式、注册表与文件关联无需修改；任一步失败会自动回滚，软件保持原状。搬家前请先退出该软件，文件被占用会导致失败。" />

        </StackPanel>
    </ScrollViewer>
</Page>
