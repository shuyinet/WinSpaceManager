<Page x:Class="SysMgr.App.Views.HistoryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="历史与回滚">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="Transparent">
        <StackPanel Margin="26,18,26,24">

            <!-- 页头 -->
            <Grid Margin="2,0,0,18">
                <StackPanel>
                    <TextBlock Text="历史与回滚" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="查看所有已提交操作，选择任意操作一键回滚"
                               Style="{StaticResource PageSubtitle}" />
                </StackPanel>
            </Grid>

            <!-- 动作栏 -->
            <Border Style="{StaticResource TechCard}" Margin="2,0,2,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Style="{StaticResource GlowButton}"
                            Content="刷新"
                            Command="{Binding RefreshCommand}" />
                    <Button Style="{StaticResource DangerButton}"
                            Grid.Column="1" Margin="10,0,0,0"
                            Content="回滚选中操作"
                            Command="{Binding RollbackCommand}" />

                    <TextBlock Grid.Column="2" Margin="14,0,0,0" VerticalAlignment="Center"
                               Text="{Binding StatusText}" FontSize="12.5"
                               Foreground="{StaticResource TextMutedBrush}" />
                </Grid>
            </Border>

            <!-- 历史表 -->
            <Border Style="{StaticResource TechCard}" Margin="2,0,2,0" Padding="0">
                <DataGrid Style="{StaticResource Dark.DataGrid}"
                          ItemsSource="{Binding Entries}"
                          SelectedItem="{Binding Selected}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="时间" Binding="{Binding CreatedAt, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="1.3*" />
                        <DataGridTextColumn Header="模块" Binding="{Binding ModuleId}" Width="1*" />
                        <DataGridTextColumn Header="FR" Binding="{Binding FrId, TargetNullValue=—}" Width="1.1*" />
                        <DataGridTextColumn Header="描述" Binding="{Binding Description}" Width="2.6*" />
                        <DataGridTextColumn Header="策略" Binding="{Binding Strategy}" Width="1.1*" />
                        <DataGridTextColumn Header="大小" Binding="{Binding TotalSizeBytes, Converter={StaticResource BytesFormatterStatic}}" Width="0.9*" />
                        <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="1.2*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- 提示 -->
            <TextBlock Margin="2,10,0,0" Opacity="0.7" TextWrapping="Wrap"
                       Text="提示：选择任意已提交的操作即可一键回滚；回滚失败项会标记 FailedNeedsManual 并跳过 LRU 清理，待人工处理。" />
        </StackPanel>
    </ScrollViewer>
</Page>
