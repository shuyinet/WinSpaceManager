<Page x:Class="SysMgr.App.Views.VisualizationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:SysMgr.App.Controls"
      Title="磁盘分析">
    <Grid Margin="26,18,26,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 页头 -->
        <Grid Grid.Row="0" Margin="2,0,0,14">
            <StackPanel>
                <TextBlock Text="磁盘分析" Style="{StaticResource PageTitle}" />
                <TextBlock Text="Treemap 可视化空间占用：双击或滚轮下钻，右键定位 / 删除（可回滚）/ 迁移"
                           Style="{StaticResource PageSubtitle}" />
            </StackPanel>
        </Grid>

        <!-- 工具栏：目标 + 筛选 -->
        <Border Grid.Row="1" Style="{StaticResource TechCard}" Margin="0,0,0,12">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <ComboBox Width="110" ItemsSource="{Binding AvailableDrives}"
                              SelectedItem="{Binding SelectedDrive}"
                              VerticalContentAlignment="Center" Margin="0,0,8,0" />
                    <TextBox Width="280" VerticalContentAlignment="Center"
                             AutomationProperties.AutomationId="txt-vis-path"
                             Text="{Binding ScanPath, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,8,0" />
                    <Button Style="{StaticResource GlowButton}" Content="扫描"
                            AutomationProperties.AutomationId="btn-vis-scan"
                            Command="{Binding ScanCommand}" Margin="0,0,8,0" />
                    <Button Style="{StaticResource GhostButton}" Content="取消"
                            Command="{Binding CancelScanCommand}" Margin="0,0,10,0" />
                    <ui:ProgressRing Width="20" Height="20" VerticalAlignment="Center"
                                     IsIndeterminate="{Binding IsScanning}"
                                     Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Margin="10,0,0,0" VerticalAlignment="Center"
                               Text="{Binding StatusText}"
                               Foreground="{StaticResource TextMutedBrush}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" Text="筛选"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,8,0" />
                    <TextBox Width="170" VerticalContentAlignment="Center"
                             Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,8,0" />
                    <TextBlock VerticalAlignment="Center" Text="≥MB"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,6,0" />
                    <ui:NumberBox Width="80" Value="{Binding MinSizeMb}" Minimum="0" Maximum="102400"
                                  Margin="0,0,8,0" />
                    <TextBlock VerticalAlignment="Center" Text="修改晚于"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,6,0" />
                    <DatePicker Width="130" SelectedDate="{Binding ModifiedAfter}" Margin="0,0,8,0" />
                    <CheckBox Content="排除隐藏/系统" IsChecked="{Binding ExcludeHidden}"
                              VerticalAlignment="Center" Margin="0,0,12,0" />
                    <Button Style="{StaticResource GhostButton}" Content="导出快照"
                            Command="{Binding ExportCommand}" Margin="0,0,10,0" />

                    <!-- 类型图例（FR-VIS-01 着色口径） -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="10" Height="10" CornerRadius="2" Background="#F59E0B" Margin="0,0,4,0" />
                        <TextBlock Text="视频" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <Border Width="10" Height="10" CornerRadius="2" Background="#38BDF8" Margin="0,0,4,0" />
                        <TextBlock Text="图片" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <Border Width="10" Height="10" CornerRadius="2" Background="#34D399" Margin="0,0,4,0" />
                        <TextBlock Text="文档" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <Border Width="10" Height="10" CornerRadius="2" Background="#F43F5E" Margin="0,0,4,0" />
                        <TextBlock Text="安装包" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <Border Width="10" Height="10" CornerRadius="2" Background="#A78BFA" Margin="0,0,4,0" />
                        <TextBlock Text="数据库" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <Border Width="10" Height="10" CornerRadius="2" Background="#8A93A6" Margin="0,0,4,0" />
                        <TextBlock Text="其他" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 主区：左 Treemap，右列表与操作 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.2*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <!-- 左：面包屑 + Treemap -->
            <Border Grid.Column="0" Style="{StaticResource TechCard}" Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Style="{StaticResource GhostButton}" Content="← 上级"
                                AutomationProperties.AutomationId="btn-vis-back"
                                Command="{Binding BackCommand}" Margin="0,0,10,0" Padding="10,4" />
                        <ItemsControl ItemsSource="{Binding Breadcrumbs}" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource GhostButton}" Padding="8,3"
                                            Content="{Binding Name}"
                                            Command="{Binding DataContext.NavigateCrumbCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                            CommandParameter="{Binding}"
                                            Margin="0,0,4,0" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <controls:TreemapControl x:Name="Treemap"
                                             Grid.Row="1"
                                             AutomationProperties.AutomationId="vis-treemap"
                                             ItemsSource="{Binding DisplayChildren}"
                                             SelectedNode="{Binding SelectedNode, Mode=TwoWay}" />
                </Grid>
            </Border>

            <!-- 右：当前层级列表 + 操作 -->
            <Border Grid.Column="1" Style="{StaticResource TechCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="当前层级" Style="{StaticResource SectionTitle}" Margin="0,0,0,4" />
                        <TextBlock Text="{Binding CurrentSummary}"
                                   Foreground="{StaticResource TextMutedBrush}" />
                    </StackPanel>

                    <DataGrid Grid.Row="1" Style="{StaticResource Dark.DataGrid}"
                              AutomationProperties.AutomationId="grid-vis-items"
                              ItemsSource="{Binding ListItems}"
                              SelectedItem="{Binding SelectedNode, Mode=TwoWay}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False"
                              MouseDoubleClick="OnListDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="名称" Binding="{Binding Name, Mode=OneWay}" Width="2*" />
                            <DataGridTextColumn Header="大小" Binding="{Binding TotalBytes, Converter={StaticResource BytesFormatterStatic}, Mode=OneWay}" Width="0.9*" />
                            <DataGridTextColumn Header="修改时间" Binding="{Binding LastWriteTime, StringFormat=yyyy-MM-dd, Mode=OneWay}" Width="0.9*" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="2" Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Style="{StaticResource GhostButton}" Content="打开位置"
                                    Command="{Binding OpenInExplorerCommand}"
                                    CommandParameter="{Binding SelectedNode}"
                                    IsEnabled="{Binding HasSelection}" Margin="0,0,6,0" />
                            <Button Style="{StaticResource GhostButton}" Content="标记待处理"
                                    AutomationProperties.AutomationId="btn-vis-tag"
                                    Command="{Binding ToggleTagCommand}"
                                    CommandParameter="{Binding SelectedNode}"
                                    IsEnabled="{Binding HasSelection}" Margin="0,0,6,0" />
                            <Button Style="{StaticResource DangerButton}" Content="删除"
                                    AutomationProperties.AutomationId="btn-vis-delete"
                                    Command="{Binding DeleteCommand}"
                                    CommandParameter="{Binding SelectedNode}"
                                    IsEnabled="{Binding HasSelection}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBox Width="200" VerticalContentAlignment="Center"
                                     Text="{Binding DestinationRoot, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,6,0" />
                            <Button Style="{StaticResource GlowButton}" Content="迁移选中项"
                                    Command="{Binding MigrateCommand}"
                                    CommandParameter="{Binding SelectedNode}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
