<Page x:Class="SysMgr.App.Views.ScreenshotPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="截图工具" Loaded="Page_Loaded" Unloaded="Page_Unloaded">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- 截图入口卡（整卡可点） -->
        <Style x:Key="CaptureCard" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" CornerRadius="14" Padding="18"
                                Background="{StaticResource CardBrush}"
                                BorderBrush="{StaticResource StrokeSoftBrush}" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="3"
                                                  Opacity="0.4" Direction="270" />
                            </Border.Effect>
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{StaticResource CardAltBrush}" />
                                <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="B" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 最近截图缩略图卡 -->
        <Style x:Key="RecentCard" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,14,14" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <StackPanel Width="168" Background="Transparent">
                            <Border x:Name="B" Width="168" Height="100" CornerRadius="10"
                                    Background="#0EFFFFFF"
                                    BorderBrush="{StaticResource StrokeSoftBrush}" BorderThickness="1">
                                <Border.Clip>
                                    <RectangleGeometry Rect="0,0,168,100" RadiusX="10" RadiusY="10" />
                                </Border.Clip>
                                <Image Source="{Binding Image}" Stretch="UniformToFill" />
                            </Border>
                            <TextBlock Text="{Binding FileName}" FontSize="11.5" Margin="2,6,2,0"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding TimeText}" FontSize="10.5" Margin="2,2,2,0"
                                       Foreground="{StaticResource TextMutedBrush}" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="Transparent">
        <StackPanel Margin="26,18,26,24">

            <!-- ===== 页头 ===== -->
            <Grid Margin="2,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Border Width="46" Height="46" CornerRadius="12" Background="#1A18C0FF" Margin="0,0,12,0">
                        <ui:SymbolIcon Symbol="Screenshot24" FontSize="22"
                                       Foreground="{StaticResource AccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource PageTitle}" Text="截图工具" />
                        <TextBlock Style="{StaticResource PageSubtitle}"
                                   Text="区域 / 全屏 / 窗口三种截法，内置标注编辑与一键保存" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource Badge}" VerticalAlignment="Center" Margin="0,0,10,0"
                            Background="#0F18C0FF">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Keyboard24" FontSize="14" Margin="0,0,6,0"
                                           Foreground="{StaticResource AccentBrush}" />
                            <TextBlock Text="{Binding HotkeyText}" FontSize="12"
                                       Foreground="{StaticResource AccentBrightBrush}" />
                        </StackPanel>
                    </Border>
                    <Button Style="{StaticResource GhostButton}" Content="打开保存目录"
                            Command="{Binding OpenSaveDirectoryCommand}" />
                </StackPanel>
            </Grid>

            <!-- ===== 三种截图方式 ===== -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Style="{StaticResource CaptureCard}"
                        AutomationProperties.AutomationId="btn-shot-region"
                        Command="{Binding CaptureRegionCommand}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="40" Height="40" CornerRadius="10" Background="#1A18C0FF">
                                <ui:SymbolIcon Symbol="Crop24" FontSize="20"
                                               Foreground="{StaticResource AccentBrush}" />
                            </Border>
                            <StackPanel VerticalAlignment="Center" Margin="12,0,0,0">
                                <TextBlock Text="区域截图" FontSize="15.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="框选任意范围" FontSize="11.5"
                                           Foreground="{StaticResource TextMutedBrush}" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Margin="0,12,0,0" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Text="拖动鼠标框选区域，实时显示尺寸与放大镜，选出即进入标注编辑器。" />
                    </StackPanel>
                </Button>

                <Button Grid.Column="1" Style="{StaticResource CaptureCard}" Margin="12,0"
                        AutomationProperties.AutomationId="btn-shot-full"
                        Command="{Binding CaptureFullScreenCommand}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="40" Height="40" CornerRadius="10" Background="#1438D39F">
                                <ui:SymbolIcon Symbol="FullScreenMaximize24" FontSize="20" Foreground="#38D39F" />
                            </Border>
                            <StackPanel VerticalAlignment="Center" Margin="12,0,0,0">
                                <TextBlock Text="全屏截图" FontSize="15.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="整个屏幕" FontSize="11.5"
                                           Foreground="{StaticResource TextMutedBrush}" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Margin="0,12,0,0" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Text="一次抓取全部显示器画面，无需框选，直接进入标注编辑器。" />
                    </StackPanel>
                </Button>

                <Button Grid.Column="2" Style="{StaticResource CaptureCard}"
                        AutomationProperties.AutomationId="btn-shot-window"
                        Command="{Binding CaptureWindowCommand}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="40" Height="40" CornerRadius="10" Background="#14FFC542">
                                <ui:SymbolIcon Symbol="WindowNew24" FontSize="20" Foreground="#FFC542" />
                            </Border>
                            <StackPanel VerticalAlignment="Center" Margin="12,0,0,0">
                                <TextBlock Text="窗口截图" FontSize="15.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="单个窗口" FontSize="11.5"
                                           Foreground="{StaticResource TextMutedBrush}" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Margin="0,12,0,0" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Text="鼠标移到目标窗口自动高亮，点击即截取该窗口完整边框范围。" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- ===== 截图设置 ===== -->
            <Border Style="{StaticResource TechCard}" Padding="18,14" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="截图设置" Style="{StaticResource SectionTitle}" Margin="0,0,0,12" />

                    <!-- 延迟 -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="延迟截图" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <ComboBox Grid.Column="1" Width="120" Height="32"
                                  AutomationProperties.AutomationId="cmb-shot-delay"
                                  ItemsSource="{Binding DelayOptions}"
                                  DisplayMemberPath="Label"
                                  SelectedValuePath="Seconds"
                                  SelectedValue="{Binding DelaySeconds, Mode=TwoWay}" />
                        <TextBlock Grid.Column="2" Margin="14,0,0,0" VerticalAlignment="Center"
                                   FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                                   Text="适合先弹出菜单或悬停状态再截图" />
                    </Grid>

                    <!-- 快捷键 -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="全局快捷键" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                         AutomationProperties.AutomationId="chk-shot-hotkey"
                                         MaxWidth="120"
                                         OnContent="已启用" OffContent="已关闭"
                                         IsChecked="{Binding HotkeyEnabled, Mode=TwoWay}" />
                        <TextBlock Grid.Column="2" Margin="14,0,0,0" VerticalAlignment="Center"
                                   FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                                   Text="Ctrl + Alt + X：程序最小化时也能直接区域截图" />
                    </Grid>

                    <!-- 保存目录 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="保存目录" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <Border Grid.Column="1" Height="32" CornerRadius="8" Background="#10000000"
                                BorderBrush="{StaticResource StrokeSoftBrush}" BorderThickness="1">
                            <TextBlock x:Name="DirectoryText" VerticalAlignment="Center" Margin="10,0"
                                       AutomationProperties.AutomationId="txt-shot-dir"
                                       FontSize="12.5" TextTrimming="CharacterEllipsis"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Text="{Binding SaveDirectory}" />
                        </Border>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="10,0,0,0">
                            <Button Style="{StaticResource GhostButton}" Content="更改目录" Height="32"
                                    Padding="12,0" AutomationProperties.AutomationId="btn-shot-choose-dir"
                                    Click="ChooseDirectory_Click" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ===== 最近截图 ===== -->
            <Border Style="{StaticResource TechCard}" Padding="18,14" Margin="0,0,0,14">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="最近截图" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="{Binding RecentSummary}" FontSize="12" Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource TextMutedBrush}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Style="{StaticResource GhostButton}" Content="刷新" Height="30"
                                    Padding="12,0" Margin="0,0,8,0"
                                    AutomationProperties.AutomationId="btn-shot-refresh"
                                    Command="{Binding RefreshRecentCommand}" />
                        </StackPanel>
                    </Grid>

                    <Border Padding="36,24">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasRecent}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel HorizontalAlignment="Center">
                            <Border Width="56" Height="56" CornerRadius="14" Background="#1018C0FF"
                                    HorizontalAlignment="Center">
                                <ui:SymbolIcon Symbol="Image24" Width="24" Height="24"
                                               Foreground="{StaticResource AccentBrush}" />
                            </Border>
                            <TextBlock Text="还没有保存过截图" FontSize="14" FontWeight="SemiBold"
                                       Margin="0,12,0,4" HorizontalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="截图后在编辑器里按 Ctrl+S 保存，这里会显示缩略图"
                                       FontSize="12" HorizontalAlignment="Center"
                                       Foreground="{StaticResource TextMutedBrush}" />
                        </StackPanel>
                    </Border>

                    <ItemsControl ItemsSource="{Binding Recent}"
                                  AutomationProperties.AutomationId="items-shot-recent"
                                  Visibility="{Binding HasRecent, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource RecentCard}"
                                        ToolTip="{Binding FilePath}"
                                        Command="{Binding DataContext.OpenRecentCommand,
                                                          RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                                        CommandParameter="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ===== 状态 + 快捷键提示 ===== -->
            <Border Style="{StaticResource TechCardAlt}" Padding="16,10">
                <StackPanel>
                    <TextBlock Text="{Binding StatusText}" FontSize="12.5"
                               Foreground="{StaticResource AccentBrightBrush}" />
                    <TextBlock Margin="0,6,0,0" Opacity="0.75" FontSize="11.5" TextWrapping="Wrap"
                               Foreground="{StaticResource TextMutedBrush}"
                               Text="编辑器快捷键：Ctrl+Z 撤销 · Ctrl+Y 重做 · Ctrl+S 保存 · Ctrl+C 复制到剪贴板 · Esc 关闭。标注支持矩形、椭圆、箭头、画笔、文字与马赛克，导出按原始像素合成。" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
