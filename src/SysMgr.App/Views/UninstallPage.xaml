<Page x:Class="SysMgr.App.Views.UninstallPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:sys="clr-namespace:System;assembly=System.Runtime"
      Title="软件卸载">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Page.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="Transparent">
        <StackPanel Margin="26,18,26,24">

            <!-- ===== 页头 ===== -->
            <Grid Margin="2,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="软件卸载" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="扫描已安装软件，标准卸载调用软件自身卸载程序；强制卸载直接清理目录/注册表/服务，走回滚快照"
                               Style="{StaticResource PageSubtitle}" />
                </StackPanel>
                <Border Grid.Column="1" Style="{StaticResource Badge}" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusText}" FontSize="12"
                               Foreground="{StaticResource AccentBrightBrush}" />
                </Border>
            </Grid>

            <!-- ===== 操作区 ===== -->
            <Border Style="{StaticResource TechCard}" Margin="0,0,0,14" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Style="{StaticResource GlowButton}"
                            Content="扫描已装软件" Command="{Binding ScanCommand}"
                            AutomationProperties.AutomationId="btn-scan"
                            Margin="0,0,10,0" />
                    <Button Grid.Column="1" Style="{StaticResource GhostButton}"
                            Content="取消" Command="{Binding CancelScanCommand}"
                            Margin="0,0,14,0" />

                    <CheckBox Grid.Column="2" Margin="0,0,14,0" VerticalAlignment="Center"
                              Content="{Binding SystemToggleText}"
                              IsChecked="{Binding ShowSystemApps}"
                              Foreground="{StaticResource TextSecondaryBrush}" />

                    <!-- 搜索框 -->
                    <Border Grid.Column="3" Background="#10000000" CornerRadius="8"
                            BorderBrush="{StaticResource StrokeSoftBrush}" BorderThickness="1"
                            Margin="0,0,0,0" Height="34">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Symbol="Search24" Width="16" Height="16" Margin="10,0,0,0"
                                           Foreground="{StaticResource TextMutedBrush}" />
                            <TextBox Grid.Column="1" Margin="6,0,10,0"
                                     AutomationProperties.AutomationId="txt-filter"
                                     VerticalContentAlignment="Center"
                                     BorderThickness="0" Background="Transparent"
                                     Foreground="{StaticResource TextPrimaryBrush}"
                                     Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                    </Border>

                    <!-- 扫描进度环 -->
                    <ui:ProgressRing Grid.Column="4" Width="28" Height="28" Margin="14,0,0,0"
                                     IsIndeterminate="{Binding IsScanning}"
                                     Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}" />
                </Grid>
            </Border>

            <!-- ===== 各盘软件统计 ===== -->
            <Border Style="{StaticResource TechCard}" Margin="0,0,0,14" Padding="16,12"
                    Visibility="{Binding HasItems, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <ui:SymbolIcon Symbol="HardDrive24" Width="16" Height="16"
                                       Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="磁盘分布" FontSize="12.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="8,0,0,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding DriveSummaryText}" FontSize="12"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Margin="12,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding DriveStats}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#0EFFFFFF" CornerRadius="8" Padding="12,8"
                                        BorderBrush="{StaticResource StrokeSoftBrush}" BorderThickness="1"
                                        Margin="0,0,10,8">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding DriveText}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="{Binding CountText}" FontSize="12"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   Margin="10,0,0,0" VerticalAlignment="Center" />
                                        <Border Background="#1418C0FF" CornerRadius="5" Padding="7,2"
                                                Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding SizeText}" FontSize="11.5"
                                                       Foreground="{StaticResource AccentBrightBrush}" />
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ===== 空状态 ===== -->
            <Border Style="{StaticResource TechCard}" Padding="48,36"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                <StackPanel HorizontalAlignment="Center">
                    <Border Width="64" Height="64" CornerRadius="16"
                            Background="#1018C0FF" HorizontalAlignment="Center">
                        <ui:SymbolIcon Symbol="AppsList24" Width="28" Height="28"
                                       Foreground="{StaticResource AccentBrush}" />
                    </Border>
                    <TextBlock Text="尚未扫描软件" FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,16,0,4"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="点击上方「扫描已装软件」按钮，获取系统中所有已安装应用列表"
                               FontSize="12.5" Foreground="{StaticResource TextMutedBrush}"
                               HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="420" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <ComboBox Width="160" SelectedIndex="{Binding CategoryIndex}">
                    <ComboBoxItem Content="全部类型" />
                    <ComboBoxItem Content="排除运行时库" />
                    <ComboBoxItem Content="仅运行时库" />
                </ComboBox>
                <ComboBox Width="180" Margin="12,0,0,0" SelectedIndex="{Binding SortIndex}">
                    <ComboBoxItem Content="按名称升序" />
                    <ComboBoxItem Content="按大小降序" />
                    <ComboBoxItem Content="按安装日期降序" />
                    <ComboBoxItem Content="按发布者升序" />
                </ComboBox>
            </StackPanel>
            <!-- ===== 软件列表 ===== -->
            <DataGrid Style="{StaticResource Dark.DataGrid}"
                      AutomationProperties.AutomationId="grid-software"
                      ItemsSource="{Binding ItemsView}"
                      SelectedItem="{Binding Selected}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserSortColumns="True"
                      RowHeight="{x:Static sys:Double.NaN}"
                      MinRowHeight="60"
                      MinHeight="200"
                      MaxHeight="520">
                <DataGrid.Columns><DataGridTextColumn Header="类型" Binding="{Binding CategoryText}" Width="90" SortMemberPath="CategoryText" />
                    <DataGridTextColumn Header="安装盘" Binding="{Binding InstallDriveText}" Width="0.6*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="ToolTip" Value="{Binding InstallLocation}" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTemplateColumn Header="软件名称" Width="2.0*" SortMemberPath="DisplayName">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid VerticalAlignment="Center" Margin="0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" Margin="0,0,12,0"
                                            Background="#10FFFFFF">
                                        <Image Width="26" Height="26"
                                               Source="{Binding IconPath, Converter={StaticResource IconToImage}}" />
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{Binding DisplayNameLines}" VerticalAlignment="Center"
                                               FontSize="13" LineHeight="18" MaxWidth="360" Margin="0,0,8,0"
                                               TextWrapping="Wrap" ToolTip="{Binding DisplayName}" />
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="安装日期" Binding="{Binding InstallDate, StringFormat=yyyy-MM-dd}" Width="1*" />
                    <DataGridTextColumn Header="大小" Width="0.9*"
                                        Binding="{Binding EstimatedSizeBytes, Converter={StaticResource BytesFormatterStatic}, TargetNullValue=—}" />
                    <DataGridTextColumn Header="使用频率" Binding="{Binding UsageFrequencyText}"
                                        SortMemberPath="UsageRank" Width="0.9*" />
                    <DataGridTemplateColumn Header="操作" Width="200" CanUserSort="False" CanUserResize="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource GhostButton}" Content="卸载"
                                            Height="28" MinWidth="68" Padding="10,0" FontSize="12" Margin="0,0,8,0"
                                            ToolTip="调用软件自带卸载程序，卸载前会先弹出执行预演确认"
                                            Command="{Binding DataContext.RowUninstallCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                            CommandParameter="{Binding}" />
                                    <Button Style="{StaticResource GhostButton}" Content="打开目录"
                                            Height="28" MinWidth="92" Padding="10,0" FontSize="12"
                                            IsEnabled="{Binding CanOpenFolder}"
                                            ToolTip="{Binding OpenableFolder, TargetNullValue=未找到该软件的安装目录}"
                                            Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- ===== 选中后操作区 ===== -->
            <Border Style="{StaticResource TechCardAlt}" Margin="0,14,0,0" Padding="16,12"
                    Visibility="{Binding HasSelected, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Warning24" Width="18" Height="18" Margin="0,0,10,0"
                                   Foreground="{StaticResource WarningBrush}" />
                    <TextBlock Text="已选中软件，请选择卸载方式：" FontSize="12.5"
                               Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"
                               Margin="0,0,18,0" />
                    <Button Style="{StaticResource GhostButton}" Content="标准卸载"
                            ToolTip="推荐：调用软件官方卸载程序，卸载更干净"
                            AutomationProperties.AutomationId="btn-standard"
                            Command="{Binding UninstallStandardCommand}" Margin="0,0,8,0" />
                    <Button Style="{StaticResource DangerButton}" Content="强制卸载"
                            ToolTip="标准卸载失败时使用：结束相关进程后直接删除安装目录"
                            Command="{Binding UninstallForceCommand}" Margin="0,0,14,0" />
                    <CheckBox VerticalAlignment="Center" Content="卸载前强制结束相关进程"
                              IsChecked="{Binding KillProcesses}"
                              Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
