<Page x:Class="SysMgr.App.Views.CSlimPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="C 盘瘦身">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="Transparent">
        <StackPanel Margin="26,18,26,24">

            <!-- 页头 -->
            <Grid Margin="2,0,0,18">
                <StackPanel>
                    <TextBlock Text="C 盘瘦身" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="分析 C 盘空间分布，迁移大文件，清除 Windows 更新残留"
                               Style="{StaticResource PageSubtitle}" />
                </StackPanel>
            </Grid>

            <!-- FR-CSLIM-01 空间分析 -->
            <Border Style="{StaticResource TechCard}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="C 盘空间分析" Style="{StaticResource SectionTitle}" Margin="0,0,0,12" />

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Button Style="{StaticResource GlowButton}" Content="分析 C 盘"
                                Command="{Binding AnalyzeCommand}" Margin="0,0,8,0" />
                        <Button Style="{StaticResource GhostButton}" Content="取消"
                                Command="{Binding CancelCommand}" Margin="0,0,12,0" />
                        <ui:ProgressRing Width="22" Height="22" VerticalAlignment="Center"
                                         IsIndeterminate="{Binding IsScanning}"
                                         Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Margin="12,0,0,0" VerticalAlignment="Center"
                                   Text="{Binding StatusText}"
                                   Foreground="{StaticResource TextMutedBrush}" />
                    </StackPanel>

                    <ProgressBar Minimum="0" Maximum="100" Height="10"
                                 Value="{Binding UsedPercent, Mode=OneWay}" Margin="0,0,0,12" />

                    <DataGrid Style="{StaticResource Dark.DataGrid}"
                              ItemsSource="{Binding AnalysisCategories}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" MaxHeight="220">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="分类" Binding="{Binding Category}" Width="1.2*" />
                            <DataGridTextColumn Header="大小" Binding="{Binding SizeBytes, Converter={StaticResource BytesFormatterStatic}}" Width="1*" />
                            <DataGridTextColumn Header="说明" Binding="{Binding Description}" Width="2.4*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- FR-CSLIM-02 大文件迁移 -->
            <Border Style="{StaticResource TechCard}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="大文件迁移" Style="{StaticResource SectionTitle}" Margin="0,0,0,12" />

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock VerticalAlignment="Center" Text="最小大小(MB):"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,8,0" />
                        <ui:NumberBox Width="90" Value="{Binding MinSizeMb}" Minimum="1" Maximum="10240" Margin="0,0,8,0" />
                        <Button Style="{StaticResource GlowButton}" Content="扫描大文件"
                                Command="{Binding ScanLargeFilesCommand}" Margin="0,0,12,0" />
                        <TextBox Width="280" VerticalContentAlignment="Center"
                                 Text="{Binding DestinationRoot, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                        <Button Style="{StaticResource GlowButton}" Content="迁移勾选项"
                                Command="{Binding MigrateCommand}" />
                    </StackPanel>

                    <DataGrid Style="{StaticResource Dark.DataGrid}"
                              ItemsSource="{Binding LargeFiles}" AutoGenerateColumns="False" CanUserAddRows="False"
                              MaxHeight="200">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="0.4*" />
                            <DataGridTextColumn Header="路径" Binding="{Binding Item.Path, Mode=OneWay}" Width="3*" />
                            <DataGridTextColumn Header="大小" Binding="{Binding Item.SizeBytes, Converter={StaticResource BytesFormatterStatic}, Mode=OneWay}" Width="0.9*" />
                            <DataGridTextColumn Header="类型" Binding="{Binding Item.Kind, Mode=OneWay}" Width="0.9*" />
                            <DataGridTextColumn Header="修改时间" Binding="{Binding Item.LastWriteTime, StringFormat=yyyy-MM-dd HH:mm, Mode=OneWay}" Width="1.2*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- FR-CSLIM-05 Windows 残留 -->
            <Border Style="{StaticResource TechCard}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Windows 更新/升级残留" Style="{StaticResource SectionTitle}" Margin="0,0,0,12" />

                    <DataGrid Style="{StaticResource Dark.DataGrid}"
                              ItemsSource="{Binding WindowsResiduals}" AutoGenerateColumns="False" CanUserAddRows="False"
                              MaxHeight="160" Margin="0,0,0,12">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="0.4*" />
                            <DataGridTextColumn Header="类型" Binding="{Binding Item.Kind, Mode=OneWay}" Width="1.2*" />
                            <DataGridTextColumn Header="路径" Binding="{Binding Item.Target, Mode=OneWay}" Width="2.4*" />
                            <DataGridTextColumn Header="大小" Binding="{Binding Item.SizeBytes, Converter={StaticResource BytesFormatterStatic}, Mode=OneWay}" Width="0.9*" />
                            <DataGridTextColumn Header="警告" Binding="{Binding Item.Warning, Mode=OneWay}" Width="2*" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <Button Style="{StaticResource DangerButton}" Content="清除勾选项"
                            Command="{Binding CleanWindowsResidualCommand}" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <!-- FR-CSLIM-08 保存位置建议 -->
            <Border Style="{StaticResource TechCard}">
                <StackPanel>
                    <TextBlock Text="默认保存位置建议" Style="{StaticResource SectionTitle}" Margin="0,0,0,12" />

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Button Style="{StaticResource GlowButton}" Content="获取建议"
                                Command="{Binding LoadSaveLocationCommand}" Margin="0,0,8,0" />
                        <Button Style="{StaticResource GhostButton}" Content="一键应用"
                                Command="{Binding ApplySaveLocationCommand}" />
                    </StackPanel>

                    <DataGrid Style="{StaticResource Dark.DataGrid}"
                              ItemsSource="{Binding SaveLocations}" AutoGenerateColumns="False" CanUserAddRows="False"
                              MaxHeight="160">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="0.4*" />
                            <DataGridTextColumn Header="类别" Binding="{Binding Suggestion.Category, Mode=OneWay}" Width="1.2*" />
                            <DataGridTextColumn Header="当前盘" Binding="{Binding Suggestion.CurrentDrive, Mode=OneWay}" Width="0.9*" />
                            <DataGridTextColumn Header="建议盘" Binding="{Binding Suggestion.SuggestedDrive, Mode=OneWay}" Width="0.9*" />
                            <DataGridTextColumn Header="说明" Binding="{Binding Suggestion.Description, Mode=OneWay}" Width="2.6*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
