<Page x:Class="SysMgr.App.Views.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:ctrl="clr-namespace:SysMgr.App.Controls"
      Title="仪表盘">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="Transparent">
        <StackPanel Margin="26,18,26,24">

            <!-- 页头 -->
            <Grid Margin="2,0,0,18">
                <StackPanel>
                    <TextBlock Text="系统仪表盘" FontSize="24" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="实时掌握系统健康状态，所有操作可预览、可回滚"
                               FontSize="12.5" Margin="2,5,0,0"
                               Foreground="{StaticResource TextMutedBrush}" />
                </StackPanel>
            </Grid>

            <Grid x:Name="MainGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="384" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- ===== 健康分主卡片 ===== -->
                <Border Style="{StaticResource TechCard}" Margin="0,0,14,0">
                    <StackPanel>
                        <Grid Height="248">
                            <!-- 闭合整环仪表盘 -->
                            <ctrl:RingProgress Margin="6"
                                               Thickness="13"
                                               IsIndeterminate="{Binding IsScanning}"
                                               Value="{Binding HealthScore}">
                                <ctrl:RingProgress.ForegroundColor>
                                    <Binding Path="ScoreBrush" />
                                </ctrl:RingProgress.ForegroundColor>
                                <ctrl:RingProgress.Effect>
                                    <DropShadowEffect Color="{Binding ScoreGlow}"
                                                      BlurRadius="22" ShadowDepth="0" Opacity="0.7" />
                                </ctrl:RingProgress.Effect>
                            </ctrl:RingProgress>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="{Binding CenterDisplay}"
                                           FontSize="62" FontWeight="Bold"
                                           Foreground="{Binding ScoreBrush}" />
                                <TextBlock Text="{Binding Rating}"
                                           FontSize="13.5" Margin="0,2,0,0"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="{Binding StatusLine}" TextWrapping="Wrap"
                                   TextAlignment="Center" FontSize="12.5"
                                   Foreground="{StaticResource TextMutedBrush}" />

                        <!-- 扫描进度 -->
                        <StackPanel Margin="0,12,0,0"
                                    Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding ScanPhase}" FontSize="12"
                                       Foreground="{StaticResource AccentBrightBrush}" />
                            <ProgressBar Height="6" Margin="0,6,0,0"
                                         Minimum="0" Maximum="100"
                                         Value="{Binding ScanPercent, Mode=OneWay}" />
                        </StackPanel>

                        <Button Style="{StaticResource GlowButton}"
                                Content="一键体检" Margin="0,16,0,0"
                                Command="{Binding QuickScanCommand}" />
                    </StackPanel>
                </Border>

                <!-- ===== 状态卡片 2×2 ===== -->
        <UniformGrid Grid.Column="1" Rows="2" Columns="2">

            <Border Style="{StaticResource TechCard}" Margin="7">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="46" Height="46" CornerRadius="12"
                            Background="#22FF4D62">
                        <ui:SymbolIcon Symbol="ErrorCircle24" Width="22" Height="22"
                                       Foreground="{StaticResource DangerBrush}" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding RiskDisplay}" FontSize="27" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="待处理风险项" FontSize="12"
                                   Foreground="{StaticResource TextMutedBrush}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource TechCard}" Margin="7">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="46" Height="46" CornerRadius="12"
                            Background="#22FFB23E">
                        <ui:SymbolIcon Symbol="Storage24" Width="22" Height="22"
                                       Foreground="{StaticResource WarningBrush}" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding RecoverableDisplay}"
                                   FontSize="25" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="可释放空间" FontSize="12"
                                   Foreground="{StaticResource TextMutedBrush}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource TechCard}" Margin="7">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="46" Height="46" CornerRadius="12"
                            Background="#2218C0FF">
                        <ui:SymbolIcon Symbol="Apps24" Width="22" Height="22"
                                       Foreground="{StaticResource AccentBrush}" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SoftwareDisplay}" FontSize="27" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="已安装软件" FontSize="12"
                                   Foreground="{StaticResource TextMutedBrush}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource TechCard}" Margin="7">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="46" Height="46" CornerRadius="12"
                            Background="#2223E3A0">
                        <ui:SymbolIcon Symbol="CheckmarkCircle24" Width="22" Height="22"
                                       Foreground="{StaticResource SuccessBrush}" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CDriveFreeDisplay}"
                                   FontSize="25" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="C 盘可用空间" FontSize="12"
                                   Foreground="{StaticResource TextMutedBrush}" />
                    </StackPanel>
                </Grid>
            </Border>

        </UniformGrid>
            </Grid>

            <!-- ===== 快捷功能入口 ===== -->
            <TextBlock Text="快捷功能" Style="{StaticResource SectionTitle}" Margin="2,22,0,10" />
            <ItemsControl ItemsSource="{Binding Entries}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" Columns="5" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Command="{Binding DataContext.NavigateCommand,
                                  RelativeSource={RelativeSource AncestorType=Page}}"
                                CommandParameter="{Binding}"
                                Margin="6,0" Cursor="Hand" Background="Transparent"
                                BorderThickness="0" Padding="0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Card" Style="{StaticResource TechCard}" Padding="16">
                                        <StackPanel>
                                            <Border Width="42" Height="42" CornerRadius="11"
                                                    Background="#2018C0FF">
                                                <ui:SymbolIcon Symbol="{Binding Icon}" Width="20" Height="20"
                                                               Foreground="{StaticResource AccentBrush}" />
                                            </Border>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                                       FontSize="14" Margin="0,12,0,2"
                                                       Foreground="{StaticResource TextPrimaryBrush}" />
                                            <TextBlock Text="{Binding Subtitle}" FontSize="11.5"
                                                       TextWrapping="Wrap"
                                                       Foreground="{StaticResource TextMutedBrush}" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Card" Property="Background" Value="{StaticResource CardAltBrush}" />
                                            <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</Page>
