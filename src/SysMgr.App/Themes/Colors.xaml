<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== 深色科技安全风 色板 ===== -->
    <Color x:Key="WindowColor">#060A11</Color>
    <Color x:Key="LayerColor">#0A111B</Color>
    <Color x:Key="CardColor">#0F1826</Color>
    <Color x:Key="CardAltColor">#14202F</Color>
    <Color x:Key="ElevatedColor">#182738</Color>

    <Color x:Key="StrokeColor">#1E3044</Color>
    <Color x:Key="StrokeSoftColor">#162536</Color>

    <Color x:Key="TextPrimaryColor">#E9F3FC</Color>
    <Color x:Key="TextSecondaryColor">#93A9BF</Color>
    <Color x:Key="TextMutedColor">#587089</Color>

    <!-- 电光青蓝强调色体系 -->
    <Color x:Key="AccentColor">#18C0FF</Color>
    <Color x:Key="AccentBrightColor">#5DD9FF</Color>
    <Color x:Key="AccentDeepColor">#0E7FCE</Color>
    <Color x:Key="AccentStartColor">#29E6FF</Color>
    <Color x:Key="AccentEndColor">#2B7DFF</Color>

    <Color x:Key="SuccessColor">#23E3A0</Color>
    <Color x:Key="WarningColor">#FFB23E</Color>
    <Color x:Key="DangerColor">#FF4D62</Color>
    <Color x:Key="PurpleColor">#9D7CFF</Color>

</ResourceDictionary>
