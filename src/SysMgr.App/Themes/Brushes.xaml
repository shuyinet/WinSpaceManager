<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="WindowBrush" Color="{StaticResource WindowColor}" />
    <SolidColorBrush x:Key="LayerBrush" Color="{StaticResource LayerColor}" />
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}" />
    <SolidColorBrush x:Key="CardAltBrush" Color="{StaticResource CardAltColor}" />
    <SolidColorBrush x:Key="ElevatedBrush" Color="{StaticResource ElevatedColor}" />

    <SolidColorBrush x:Key="StrokeBrush" Color="{StaticResource StrokeColor}" />
    <SolidColorBrush x:Key="StrokeSoftBrush" Color="{StaticResource StrokeSoftColor}" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentBrightBrush" Color="{StaticResource AccentBrightColor}" />
    <SolidColorBrush x:Key="AccentDeepBrush" Color="{StaticResource AccentDeepColor}" />

    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource AccentStartColor}" Offset="0" />
        <GradientStop Color="{StaticResource AccentEndColor}" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AccentVerticalGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource AccentStartColor}" Offset="0" />
        <GradientStop Color="{StaticResource AccentEndColor}" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="PurpleBrush" Color="{StaticResource PurpleColor}" />

    <!-- 背景氛围光：左上青蓝 -->
    <RadialGradientBrush x:Key="AmbientGlow" Center="0.14,-0.15" GradientOrigin="0.14,-0.15"
                         RadiusX="0.85" RadiusY="0.85">
        <GradientStop Color="#440E95CE" Offset="0" />
        <GradientStop Color="#140E95CE" Offset="0.45" />
        <GradientStop Color="#00000000" Offset="0.75" />
    </RadialGradientBrush>

    <!-- 背景氛围光：右下紫罗兰 -->
    <RadialGradientBrush x:Key="SecondaryGlow" Center="1.05,1.1" GradientOrigin="1.05,1.1"
                         RadiusX="0.7" RadiusY="0.7">
        <GradientStop Color="#2E9D7CFF" Offset="0" />
        <GradientStop Color="#00000000" Offset="0.7" />
    </RadialGradientBrush>

</ResourceDictionary>
