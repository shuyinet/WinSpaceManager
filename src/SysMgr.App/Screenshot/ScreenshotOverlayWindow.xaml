<Window x:Class="SysMgr.App.Screenshot.ScreenshotOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="截图选区" WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True" Background="Black"
        WindowStartupLocation="Manual" SnapsToDevicePixels="True"
        Cursor="Cross" UseLayoutRounding="True">

    <Grid x:Name="Root" ClipToBounds="True">
        <!-- 冻结的屏幕画面 -->
        <Image x:Name="ScreenImage" Stretch="Fill" />

        <Canvas x:Name="Layer" Background="Transparent">
            <!-- 暗色遮罩（四块） -->
            <Rectangle x:Name="DimTop" Fill="#A6000000" />
            <Rectangle x:Name="DimLeft" Fill="#A6000000" />
            <Rectangle x:Name="DimRight" Fill="#A6000000" />
            <Rectangle x:Name="DimBottom" Fill="#A6000000" />

            <!-- 选区边框 -->
            <Rectangle x:Name="SelectionBorder" Stroke="#18C0FF" StrokeThickness="1.5"
                       Visibility="Collapsed" />
            <Rectangle x:Name="SelectionFill" Fill="#0DFFFFFF" Visibility="Collapsed" />

            <!-- 窗口拾取高亮 -->
            <Rectangle x:Name="WindowHighlight" Stroke="#18C0FF" StrokeThickness="2"
                       Fill="#1418C0FF" Visibility="Collapsed" />

            <!-- 尺寸 / 提示徽标 -->
            <Border x:Name="SizeBadge" Background="#E6101820" BorderBrush="#3818C0FF"
                    BorderThickness="1" CornerRadius="6" Padding="8,3" Visibility="Collapsed">
                <TextBlock x:Name="SizeText" Foreground="#EAF4FF" FontSize="12"
                           FontFamily="Consolas, Microsoft YaHei UI" />
            </Border>

            <!-- 放大镜 -->
            <Border x:Name="Magnifier" Width="132" Height="132" Background="#EE0B1118"
                    BorderBrush="#3818C0FF" BorderThickness="1" CornerRadius="10"
                    Visibility="Collapsed">
                <Border.Clip>
                    <RectangleGeometry Rect="0,0,132,132" RadiusX="9" RadiusY="9" />
                </Border.Clip>
                <Grid>
                    <Image x:Name="MagnifierImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                    <TextBlock x:Name="MagnifierText" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                               Margin="0,0,0,6" FontSize="11" Foreground="#9FD7F0"
                               FontFamily="Consolas" />
                </Grid>
            </Border>
        </Canvas>

        <!-- 顶部操作提示（Grid 内居中，不随 Canvas 布局） -->
        <Border x:Name="HintBar" Background="#E6101820" BorderBrush="#2AFFFFFF"
                BorderThickness="1" CornerRadius="18" Padding="18,8"
                HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,26,0,0">
            <TextBlock x:Name="HintText" Foreground="#EAF4FF" FontSize="13"
                       Text="拖动鼠标选择截图区域 · Esc 取消" />
        </Border>
    </Grid>
</Window>
