<Window x:Class="SysMgr.App.Screenshot.ScreenshotEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:SysMgr.App.Screenshot"
        Title="截图编辑" Width="1180" Height="780" MinWidth="820" MinHeight="560"
        WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        Background="#0B1118" UseLayoutRounding="True" SnapsToDevicePixels="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                            CornerRadius="0" GlassFrameThickness="0" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- 工具按钮 -->
        <Style x:Key="ToolChip" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#C9E6F5" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Padding" Value="11,6" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="B" CornerRadius="7" Background="#12FFFFFF"
                                BorderBrush="#26FFFFFF" BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#3A18C0FF" />
                                <Setter TargetName="B" Property="BorderBrush" Value="#18C0FF" />
                                <Setter Property="Foreground" Value="#EAF8FF" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#1F18C0FF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="B" Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 颜色圆点 -->
        <Style x:Key="ColorDot" TargetType="RadioButton">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Ellipse x:Name="Ring" Width="22" Height="22" Stroke="Transparent" StrokeThickness="2" />
                            <Ellipse Width="14" Height="14" Fill="{TemplateBinding Background}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ring" Property="Stroke" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="Stroke" Value="#80FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 图标动作按钮 -->
        <Style x:Key="IconAction" TargetType="Button">
            <Setter Property="Foreground" Value="#C9E6F5" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" CornerRadius="7" Background="#10FFFFFF"
                                BorderBrush="#22FFFFFF" BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#1F18C0FF" />
                                <Setter TargetName="B" Property="BorderBrush" Value="#18C0FF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="B" Property="Opacity" Value="0.3" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#2A3A4A" BorderThickness="1" Background="#0B1118">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="32" />
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Border Grid.Row="0" Background="#0E1620" BorderBrush="#1C2A38" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                        <Ellipse Width="8" Height="8" Fill="#18C0FF" Margin="0,0,10,0" />
                        <TextBlock Text="截图编辑" FontSize="13" FontWeight="SemiBold" Foreground="#E6F4FF" />
                        <TextBlock x:Name="TitleHint" FontSize="12" Foreground="#5E7A8C"
                                   Margin="12,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                        <Button x:Name="MinimizeButton" Style="{StaticResource IconAction}" Content="—"
                                Padding="10,2" Click="Minimize_Click" />
                        <Button x:Name="CloseButton" Style="{StaticResource IconAction}" Content="✕"
                                Padding="10,2" Margin="0" Click="Close_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 工具栏 -->
            <Border Grid.Row="1" Background="#0C141C" BorderBrush="#1C2A38" BorderThickness="0,0,0,1" Padding="12,8">
                <WrapPanel Orientation="Horizontal">
                    <RadioButton x:Name="ToolRectangle" Style="{StaticResource ToolChip}" Content="矩形"
                                 GroupName="tool" IsChecked="True" Tag="Rectangle" Checked="Tool_Checked" />
                    <RadioButton x:Name="ToolEllipse" Style="{StaticResource ToolChip}" Content="椭圆"
                                 GroupName="tool" Tag="Ellipse" Checked="Tool_Checked" />
                    <RadioButton x:Name="ToolArrow" Style="{StaticResource ToolChip}" Content="箭头"
                                 GroupName="tool" Tag="Arrow" Checked="Tool_Checked" />
                    <RadioButton x:Name="ToolPen" Style="{StaticResource ToolChip}" Content="画笔"
                                 GroupName="tool" Tag="Pen" Checked="Tool_Checked" />
                    <RadioButton x:Name="ToolText" Style="{StaticResource ToolChip}" Content="文字"
                                 GroupName="tool" Tag="Text" Checked="Tool_Checked" />
                    <RadioButton x:Name="ToolMosaic" Style="{StaticResource ToolChip}" Content="马赛克"
                                 GroupName="tool" Tag="Mosaic" Checked="Tool_Checked" />

                    <Rectangle Width="1" Height="20" Fill="#2240555F" Margin="8,4,14,4" />

                    <RadioButton Style="{StaticResource ColorDot}" GroupName="color" IsChecked="True"
                                 Background="#FF4D62" Tag="#FF4D62" Checked="Color_Checked" />
                    <RadioButton Style="{StaticResource ColorDot}" GroupName="color"
                                 Background="#FFC542" Tag="#FFC542" Checked="Color_Checked" />
                    <RadioButton Style="{StaticResource ColorDot}" GroupName="color"
                                 Background="#38D39F" Tag="#38D39F" Checked="Color_Checked" />
                    <RadioButton Style="{StaticResource ColorDot}" GroupName="color"
                                 Background="#18C0FF" Tag="#18C0FF" Checked="Color_Checked" />
                    <RadioButton Style="{StaticResource ColorDot}" GroupName="color"
                                 Background="#FFFFFF" Tag="#FFFFFF" Checked="Color_Checked" />
                    <RadioButton Style="{StaticResource ColorDot}" GroupName="color"
                                 Background="#121A22" Tag="#121A22" Checked="Color_Checked" />

                    <Rectangle Width="1" Height="20" Fill="#2240555F" Margin="2,4,14,4" />

                    <RadioButton Style="{StaticResource ToolChip}" Content="细" GroupName="width"
                                 Tag="2" Checked="Width_Checked" />
                    <RadioButton Style="{StaticResource ToolChip}" Content="中" GroupName="width"
                                 IsChecked="True" Tag="4" Checked="Width_Checked" />
                    <RadioButton Style="{StaticResource ToolChip}" Content="粗" GroupName="width"
                                 Tag="8" Checked="Width_Checked" />

                    <Rectangle Width="1" Height="20" Fill="#2240555F" Margin="8,4,14,4" />

                    <Button x:Name="UndoButton" Style="{StaticResource IconAction}" Content="撤销"
                            Click="Undo_Click" />
                    <Button x:Name="RedoButton" Style="{StaticResource IconAction}" Content="重做"
                            Click="Redo_Click" />
                    <Button x:Name="ClearButton" Style="{StaticResource IconAction}" Content="清空"
                            Click="Clear_Click" />
                </WrapPanel>
            </Border>

            <!-- 画布 -->
            <Border Grid.Row="2" Background="#060A0E" Padding="12">
                <Border Background="#04070A" CornerRadius="6" ClipToBounds="True">
                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="6">
                        <Grid x:Name="CanvasHost" Background="#00000000" Cursor="Cross"
                              MouseLeftButtonDown="Canvas_MouseLeftButtonDown"
                              MouseMove="Canvas_MouseMove"
                              MouseLeftButtonUp="Canvas_MouseLeftButtonUp">
                            <Image x:Name="BaseImage" Stretch="Fill" />
                            <local:AnnotationLayer x:Name="Layer" IsHitTestVisible="False" />
                        </Grid>
                    </Viewbox>
                </Border>
            </Border>

            <!-- 状态栏 -->
            <Border Grid.Row="3" Background="#0C141C" BorderBrush="#1C2A38" BorderThickness="0,1,0,0">
                <Grid Margin="14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="SizeLabel" VerticalAlignment="Center" FontSize="12"
                               Foreground="#7E9AAB" />

                    <TextBlock Grid.Column="1" x:Name="StatusLabel" VerticalAlignment="Center"
                               FontSize="12" Foreground="#7E9AAB" Margin="18,0,0,0"
                               TextTrimming="CharacterEllipsis" />

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource IconAction}" Content="复制" Click="Copy_Click" Height="24"
                                Padding="10,1" />
                        <Button Style="{StaticResource IconAction}" Content="保存" Click="Save_Click" Height="24"
                                Padding="10,1" />
                        <Button Style="{StaticResource IconAction}" Content="关闭" Click="Close_Click" Height="24"
                                Padding="10,1" Margin="0" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
